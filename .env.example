# ── Service ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Shared secret. Must match AI_SERVICE_TOKEN in the Rails .env.
# Leave blank to disable auth (local development only).
AI_SERVICE_TOKEN=

# Comma-separated origins allowed to call this service directly.
# Normally only Rails talks to it, so the default is restrictive.
ALLOWED_ORIGINS=http://localhost:3000

# Reject uploads larger than this (MB).
MAX_UPLOAD_MB=12

# ── Providers ────────────────────────────────────────────────────
# Which provider handles the diffusion-scale endpoints.
# auto | replicate | huggingface | none
SKETCH_PROVIDER=auto
TRYON_PROVIDER=auto

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_SKETCH_MODEL=stability-ai/sdxl
REPLICATE_TRYON_MODEL=cuuupid/idm-vton

# Hugging Face — https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_SKETCH_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Seconds to wait on a hosted model before giving up.
PROVIDER_TIMEOUT=120

# ── Local CV ─────────────────────────────────────────────────────
# u2net (general) | u2netp (lighter/faster) | isnet-general-use (sharper edges)
REMBG_MODEL=u2net

# How the garment is blended onto the wearer's photo.
#   seamless — edges vanish, but the garment's colour can drift
#   alpha    — exact garment colour, slightly more visible edge
# Try both on your own photos; colour fidelity matters in a tailoring preview.
TRYON_BLEND=seamless
# 0 = flat garment, 1 = fully takes on the wearer's light and shade.
TRYON_SHADING_STRENGTH=0.55
# Longest edge, in px, that processed design assets are resized to.
ASSET_MAX_EDGE=1400
